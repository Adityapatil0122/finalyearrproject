# Hostinger-friendly Apache config:
# - Let /api/*.php run normally (PHP handles them).
# - Everything else that isn't a real file falls through to /index.html (SPA).
# - Long-cache built assets, no-cache index.html.

# Block direct browser access to the knowledge base (PHP can still read it from disk).
<Files "knowledge.md">
  Require all denied
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Block knowledge.md (defense in depth alongside <Files> above)
  RewriteRule ^knowledge\.md$ - [F,L]

  # Don't rewrite real files or directories.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Don't rewrite API requests — let PHP handle them.
  RewriteRule ^api/ - [L]

  # SPA fallback: anything else → index.html
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Hashed asset files: cache forever
  <FilesMatch "\.(?:css|js|woff2?|svg|png|jpg|jpeg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML entry: never cache
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
